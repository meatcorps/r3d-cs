<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <EnableDefaultItems>false</EnableDefaultItems>
        <RootNamespace>R3D_cs</RootNamespace>
        <AssemblyName>R3D-cs</AssemblyName>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Meatcorps.R3D-cs</PackageId>
        <Title>R3D-cs - Meatcorps Fork</Title>

        <Description>
            Meatcorps fork of the .NET/C# bindings for r3d,
            an advanced 3D rendering library for raylib.
        </Description>

        <RepositoryUrl>https://github.com/YOUR-ACCOUNT/r3d-cs/</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <Authors>r3d-cs;Meatcorps</Authors>

        <PackageLicenseExpression>Zlib</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo/r3d-cs_256x256.png</PackageIcon>
        <PackageTags>raylib r3d csharp gamedev meatcorps</PackageTags>

        <PackageProjectUrl>https://github.com/YOUR-ACCOUNT/r3d-cs/</PackageProjectUrl>

        <IsPackable>true</IsPackable>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Build.props"/>
        <None Include="logo/r3d-cs_256x256.png" Pack="true" PackagePath="logo"/>
        <None Include="../README.md" Pack="true" PackagePath=""/>
        <None Include="../LICENSE" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Raylib-cs" Version="8.1.0" ExcludeAssets="native" PrivateAssets="native" />
    </ItemGroup>

    <Import Project="./Build.props"/>

    <ItemGroup>
        <Content Include="runtimes/**" Link="runtimes/%(RecursiveDir)/%(Filename)%(Extension)">
            <PackagePath>runtimes/</PackagePath>
            <Pack>true</Pack>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Remove="runtimes/**/.gitkeep" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="enums\**\*.cs"/>
        <Compile Include="interop\**\*.cs"/>
        <Compile Include="types\**\*.cs"/>
    </ItemGroup>

</Project>
